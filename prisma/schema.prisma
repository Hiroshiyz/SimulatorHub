datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Party {
  id              String      @id @default(uuid())
  countryCode     String      @map("country_code")
  partyId         String      @map("party_id")
  role            String      // "CPO" or "EMSP"
  name            String?
  rateLimit       Int?        @map("rate_limit")
  rateLimitWindow Int?        @map("rate_limit_window")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  
  credential  Credential?
  locations   Location[]
  sessions    Session[]
  cdrs        Cdr[]

  @@unique([countryCode, partyId, role])
  @@map("parties")
}

model Credential {
  id         String   @id @default(uuid())
  tokenA     String?  @unique @map("token_a")
  tokenB     String?  @unique @map("token_b")
  tokenC     String?  @unique @map("token_c")
  url        String?
  partyId    String   @unique @map("party_id")
  party      Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("credentials")
}

model Location {
  partyId     String   @map("party_id")
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  id          String   // Location ID from OCPI
  name        String?
  address     String
  city        String
  postalCode  String?  @map("postal_code")
  country     String
  coordinates Json
  rawJson     Json     @map("raw_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  evses       Evse[]

  @@id([partyId, id])
  @@map("locations")
}

model Evse {
  locationPartyId String   @map("location_party_id")
  locationId      String   @map("location_id")
  location        Location @relation(fields: [locationPartyId, locationId], references: [partyId, id], onDelete: Cascade)
  uid             String   // EVSE UID
  id              String?  // EVSE ID
  status          String
  rawJson         Json     @map("raw_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@id([locationPartyId, locationId, uid])
  @@map("evses")
}

model Session {
  partyId    String   @map("party_id")
  party      Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  id         String   // Session ID from OCPI
  locationId String   @map("location_id")
  evseUid    String   @map("evse_uid")
  status     String
  kwh        Float
  rawJson    Json     @map("raw_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([partyId, id])
  @@map("sessions")
}

model Cdr {
  partyId   String   @map("party_id")
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  id        String   // CDR ID from OCPI
  rawJson   Json     @map("raw_json")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([partyId, id])
  @@map("cdrs")
}
